# Copy to .env for local Docker testing; never commit real secrets.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# OpenRouter free-model router. Free model availability/quotas can change.
AI_PROVIDER=openrouter
AI_PROVIDER_API_KEY=
AI_MODEL_NAME=openrouter/free
AI_BASE_URL=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Patientshell Dr. Anya
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
# Frontend values are embedded at build time (public values only).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_API_BASE_URL=
HOST_PORT=8000
